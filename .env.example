# Copy to .env and adjust for your environment. Every value here has a safe
# default in src/config.py, so .env is optional for local development.

# --- Data paths (defaults resolve relative to the project root) ---
# RAW_DATA_PATH=data/raw/data.csv
# CLEANED_DATA_PATH=data/processed/data_cleaned.csv
# CUSTOMER_FEATURES_PATH=data/processed/customer_features.csv
# LABELED_DATA_PATH=data/processed/customer_features_labeled.csv

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=Credit Risk Modeling
MODEL_NAME=CreditRiskModel
MODEL_ALIAS=champion
# Only used if the `champion` alias has never been set (first run):
# FALLBACK_MODEL_VERSION=1

# --- Modeling ---
RANDOM_STATE=42
TEST_SIZE=0.2
N_RISK_CLUSTERS=3
PROMOTION_MIN_ROC_AUC_GAIN=0.0

# --- API / logging ---
LOG_LEVEL=INFO
LOG_JSON=false

# --- MLflow HTTP client tuning ---
# mlflow's client retries with exponential backoff by default, which can make
# an unreachable tracking server take well over a minute to fail. The API
# loads the model in a background task specifically so this can't block
# /health, but tightening these still makes /ready converge faster and makes
# `train.py`/`predict.py` fail fast instead of hanging when MLflow is down.
# MLFLOW_HTTP_REQUEST_MAX_RETRIES=2
# MLFLOW_HTTP_REQUEST_TIMEOUT=10
